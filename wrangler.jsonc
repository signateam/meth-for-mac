{
  // trymeth.com: static site served from Cloudflare (Workers static assets).
  // Deploy with ./script/deploy_site.sh, which stages site/ into dist/site-deploy first.
  "name": "trymeth",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist/site-deploy",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // Flip to "true" once trymeth.com's Email Sending DNS records are live and a test send works.
    "EMAIL_LINK_ENABLED": "false"
  },
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "ratelimits": [
    { "name": "EMAIL_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "routes": [
    { "pattern": "trymeth.com", "custom_domain": true },
    { "pattern": "www.trymeth.com", "custom_domain": true }
  ]
}
